APP_NAME=Learning Platform API
DATABASE_URL=postgresql+psycopg://learning:local-development-only@127.0.0.1:5433/learning_platform
REDIS_CACHE_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_URL=redis://127.0.0.1:6379/1
QUEUE_NAME=learning-platform
# Generate a secret using: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=learning-platform
JWT_AUDIENCE=learning-platform-api
ACCESS_TOKEN_MINUTES=30
TRIAL_DAYS=14
CACHE_SECONDS=60
EXPIRATION_INTERVAL_SECONDS=60
# Pydantic Settings expects a JSON array.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
